# Admin password (required for admin login)
# Use a long, unique value. The legacy name VETA_ADMIN_PASSWORD is still read.
VETERM_ADMIN_PASSWORD=your-secure-password-here

# Optional: change the read-only guest password (default: guest)
# VETERM_GUEST_PASSWORD=guest

# Optional server settings
# PORT=8000
# HOST=0.0.0.0
# SITE_URL=https://your-domain.example

# main.js loads .env automatically when it exists.
# Copy this file to .env for local development:
#   cp .env.example .env
